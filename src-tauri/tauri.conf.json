{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OLEA Desktop",
  "version": "3.0.0",
  "identifier": "it.olea.gestionale",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "OLEA — Gestionale olio",
        "width": 1480,
        "height": 920,
        "minWidth": 1050,
        "minHeight": 680,
        "center": true,
        "backgroundColor": "#f5f7f3"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png", "icons/icon.ico"],
    "createUpdaterArtifacts": false
  }
}
